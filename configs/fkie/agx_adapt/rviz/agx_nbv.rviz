Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 30
      Reference Frame: <Fixed Frame>
    - Class: rviz/RobotModel
      Name: AGX
      Enabled: true
      Description Topic: /robot_description
      Visual Enabled: true
      Collision Enabled: false
      TF Prefix: ""
    - Class: rviz/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.35
      Show Axes: true
      Show Names: false
      Frames:
        All Enabled: false
        base_link: {Value: true}
        turret_link: {Value: true}
        d455_depth_optical_frame: {Value: true}
        d455_color_optical_frame: {Value: true}
        world: {Value: true}
    # Image panels do not overlay TF/markers (unlike Camera display).
    - Class: rviz/Image
      Name: RGB
      Enabled: true
      Image Topic: /realsense/rgb/image_raw
      Transport Hint: raw
      Normalize Range: true
    - Class: rviz/Image
      Name: Depth
      Enabled: true
      Image Topic: /realsense/depth/image_raw
      Transport Hint: raw
      Normalize Range: true
    # Disabled: Camera overlays 3D TF axes onto the image (reason we once split windows).
    - Class: rviz/Camera
      Name: CamView
      Enabled: false
      Image Topic: /realsense/rgb/image_raw
      Transport Hint: raw
    - Class: rviz/PointCloud2
      Name: DepthCloud_optical_frame
      Enabled: true
      Topic: /realsense/depth/points2
      Size (m): 0.02
      Style: Points
      Color Transformer: AxisColor
      Queue Size: 5
      # Live D455 depth (frame d455_depth_optical_frame) — not OctoMap
    - Class: octomap_rviz_plugin/ColorOccupancyGrid
      Name: Octomap_world_fused
      Enabled: true
      Octomap Topic: /robot/octomap_full
      Queue Size: 2
      Voxel Alpha: 0.75
      # Fused occupancy — distinct from single-frame DepthCloud
    - Class: rviz/MarkerArray
      Name: RRT
      Enabled: true
      Marker Topic: /robot/viz_rrt
    - Class: rviz/MarkerArray
      Name: BestBranch
      Enabled: true
      Marker Topic: /robot/viz_best_branch
    - Class: rviz/MarkerArray
      Name: Frontiers
      Enabled: true
      Marker Topic: /robot/viz_curr_frontiers
    - Class: rviz/MarkerArray
      Name: CachedNodes
      Enabled: true
      Marker Topic: /robot/viz_cached_nodes
    - Class: rviz/Marker
      Name: PlanningBBx
      Enabled: true
      Marker Topic: /robot/viz_planning_bbx
    - Class: rviz/PoseArray
      Name: NBVGoals
      Enabled: true
      Topic: /robot/nbv_goals_viz
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 10
      Focal Point:
        X: -5.36
        Y: -5.685
        Z: 0.6
      Name: Current View
      Pitch: 0.55
      Yaw: 0.9
Window Geometry:
  Height: 1000
  Width: 1600
  X: 40
  Y: 40
