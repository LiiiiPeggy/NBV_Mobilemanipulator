# NBV-owned perception image (GroundingDINO + SAM2). Does NOT mount or depend on DovSG.
# Base torch CUDA should match host driver (A6000 / CUDA 12.x).
FROM pytorch/pytorch:2.3.1-cuda12.1-cudnn8-runtime

WORKDIR /workspace
ENV NBV_ROOT=/workspace \
    NBV_PERCEPTION_ROOT=/workspace \
    PYTHONPATH=/workspace \
    TRANSFORMERS_OFFLINE=1 \
    HF_HOME=/workspace/checkpoints \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      git build-essential libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Expect repo bind-mounted at /workspace (same convention as FKIE compose).
# Install editable vendors after mount via entrypoint or:
#   pip install -e perception/vendor/GroundingDINO --no-build-isolation --no-deps
#   pip install -e perception/vendor/segment-anything-2 --no-build-isolation --no-deps

COPY scripts/run_object_perception.sh /usr/local/bin/run_object_perception.sh
RUN chmod +x /usr/local/bin/run_object_perception.sh

CMD ["bash", "-lc", "python -c 'import torch; print(torch.__version__, torch.cuda.is_available())'"]
